REM Title: Windowcloser (for rubber ducky)

REM Author: Carson: https://github.com/SchulCar2034-ui

REM Description: Closes windows with customizable settings

REM Target: Almost any PC operating system

REM Settings below 
VAR $REPEAT = 15
REM $REPEAT is how many times it runs
VAR $DELAY = 100
REM $DELAY is how many milliseconds it delays by

WHILE ( $REPEAT > 0 )
ALT F4
DELAY $DELAY
$REPEAT = ( $REPEAT - 1 )
END_WHILE
